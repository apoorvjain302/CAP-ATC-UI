{
  "_version": "1.65.0",
  "sap.app": {
    "id":          "com.sap.atcanalysis",
    "type":        "application",
    "title":       "SAP ATC Analysis",
    "description": "SAP ATC Code Analysis Tool",
    "applicationVersion": { "version": "1.1.0" },
    "dataSources": {
      "ATCService": {
        "uri":        "/api/atc/",
        "type":       "OData",
        "settings":   { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": {
    "technology":      "UI5",
    "icons":           { "icon": "sap-icon://home-share" },
    "deviceTypes":     { "desktop": true, "tablet": true, "phone": false },
    "supportedThemes": ["sap_horizon", "sap_fiori_3"]
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "com.sap.atcanalysis.view.App",
      "type":     "XML",
      "id":       "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core":    {},
        "sap.m":          {},
        "sap.ui.layout":  {},
        "sap.ui.unified": {},
        "sap.viz":        {}
      }
    },
    "contentDensities": {
      "compact":  true,
      "cozy":     true
    },
    "resources": {
      "css": [
        { "uri": "css/style.css" }
      ]
    },
    "models": {
      "i18n": {
        "type":     "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "com.sap.atcanalysis.i18n.i18n" }
      },
      "": {
        "type": "sap.ui.model.odata.v4.ODataModel",
        "settings": {
          "serviceUrl":         "/api/atc/",
          "synchronizationMode": "None",
          "operationMode":      "Server"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType":    "XML",
        "viewPath":    "com.sap.atcanalysis.view",
        "controlId":   "appNav",
        "controlAggregation": "pages"
      },
      "routes": [
        { "pattern": "",     "name": "home",    "target": "upload" },
        { "pattern": "results/{jobId}", "name": "results", "target": "results" }
      ],
      "targets": {
        "upload":  { "viewName": "Upload" },
        "results": { "viewName": "Results" }
      }
    }
  }
}
