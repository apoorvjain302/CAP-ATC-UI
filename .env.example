# ── SAP connection (local dev) ────────────────────────────────────────────────
SAP_URL=https://<host>:<port>
SAP_CLIENT=100
SAP_USERNAME=<your_username>
SAP_PASSWORD=<your_password>

# ── BTP Destination name (CF deployment) ─────────────────────────────────────
SAP_DESTINATION=I10_ATC

# ── CAP database (local = SQLite, CF = HANA) ─────────────────────────────────
# On CF, bind cap-atc-db HANA service — CAP picks it up via VCAP_SERVICES

# ── Force SQLite for local dev ────────────────────────────────────────────────
CDS_REQUIRES_DB_KIND=sqlite

CDS_REQUIRES_AUTH_KIND=dummy
